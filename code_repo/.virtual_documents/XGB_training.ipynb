random_state = 76
results_summary = []

def _pred_from_proba(model, X, cutoff=0.5):
    if hasattr(model, 'predict_proba'):
        proba = model.predict_proba(X)
        # assume binary classifier: take prob of class 1
        if proba.ndim == 2 and proba.shape[1] >= 2:
            p1 = proba[:, 1]
        else:
            p1 = np.ravel(proba)
        return (p1 >= cutoff).astype(int)
    return model.predict(X)

test_size = 0.30
sampling_fraction = 0.1  # kept for consistency with previous code (not used here)





print("\n==================== sn1 raw ====================")
X_sn1_raw = df_sn1_raw.iloc[:, :-1]
y_sn1_raw = df_sn1_raw.iloc[:, -1]

X_sn1_raw_train, X_sn1_raw_test, y_sn1_raw_train, y_sn1_raw_test = train_test_split(
    X_sn1_raw, y_sn1_raw, test_size=test_size, shuffle=True, random_state=random_state
)

scaler_sn1_raw = StandardScaler()
X_sn1_raw_train_scaled = scaler_sn1_raw.fit_transform(X_sn1_raw_train)
X_sn1_raw_test_scaled = scaler_sn1_raw.transform(X_sn1_raw_test)

xgb_sn1_raw = XGBoostGS(
    use_scaler=False,
    halving=True,
    n_splits=5,
    random_state=random_state,
    n_jobs=-1,
    verbose=0
)

xgb_sn1_raw.fit(X_sn1_raw_train_scaled, y_sn1_raw_train)

xgb_sn1_raw_cm = prob_cutoff_confusion_matrix(xgb_sn1_raw, X_sn1_raw_test_scaled, y_sn1_raw_test)
xgb_sn1_raw_acc = np.trace(xgb_sn1_raw_cm) / len(y_sn1_raw_test)

print("XGB sn1 raw accuracy:", xgb_sn1_raw_acc)
print("XGB sn1 raw confusion matrix:\n", xgb_sn1_raw_cm)


xgb_sn1_raw_y_pred = _pred_from_proba(xgb_sn1_raw, X_sn1_raw_test_scaled, cutoff=0.5)
xgb_sn1_raw_f1 = f1_score(y_sn1_raw_test, xgb_sn1_raw_y_pred)
print("XGB sn1_raw f1:", xgb_sn1_raw_f1)
results_summary.append({
    'tag': 'sn1_raw',
    'accuracy': float(xgb_sn1_raw_acc),
    'f1': float(xgb_sn1_raw_f1),
    'confusion_matrix': xgb_sn1_raw_cm.tolist(),
})

filename_model_sn1_raw = os.path.join(save_dir, "xgb_sn1_raw_model_ft_last.sav")
filename_scaler_sn1_raw = os.path.join(save_dir, "xgb_sn1_raw_scaler_ft_last.sav")

